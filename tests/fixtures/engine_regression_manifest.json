{
  "version": 2,
  "description": "Test-stage regression contracts for engine support. Fixtures must be synthetic or redistributable; commercial game files stay outside the repository.",
  "sample_schema": {
    "kinds": [
      "synthetic",
      "redistributable",
      "manual",
      "contract"
    ],
    "covers": [
      "detect",
      "extract",
      "translate",
      "repack",
      "runtime",
      "launcher",
      "diagnostics",
      "unsupported"
    ]
  },
  "engines": {
